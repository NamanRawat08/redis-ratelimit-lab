{
  "name": "redis-ratelimit-lab",
  "version": "0.1.0",
  "description": "Distributed rate limiter for Express, backed by Redis + Lua. Compares token bucket and sliding window under bursts.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "burst": "node scripts/burst.js",
    "race": "node scripts/race-demo.js",
    "multi": "node scripts/multi-instance.js",
    "bench": "node bench/limiters.js",
    "bench:http": "node bench/http.js",
    "bench:burst": "node bench/burst-sim.js"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  }
}
